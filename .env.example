# Khamis Computers — environment configuration
# Copy this file to `.env` and fill in real values.
# On cPanel you can also skip `.env` and edit app/config/config.php directly.

# Application
APP_NAME="Khamis Computers"
APP_TAGLINE="POS & Online Shop"
APP_ENV=production        # production | development
APP_DEBUG=false
APP_TIMEZONE="Africa/Nairobi"   # used for all timestamps, receipts & reports

# Database
# Use "mysql" on cPanel (production). "sqlite" is only for quick local testing.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=khamis_db
DB_USER=khamis_user
DB_PASS=CHANGE_ME

# Optional overrides
CURRENCY=KSh
VAT_RATE=16
SESSION_NAME=KC_SESSID
